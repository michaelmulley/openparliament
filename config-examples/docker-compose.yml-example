services:
  op:
    build: ./
    ports:
      - "8000"
    environment:
      - DATABASE_URL=postgres://op:op@postgres/parliament
    volumes:
      - opmedia:/mediafiles
      # To edit settings, you can use something like this:
      # - ./docker-settings.py:/app/parliament/settings.py
    depends_on:
      - postgres    

  postgres:
    image: postgres:18
    volumes:
      - pgdata:/var/lib/postgresql
    environment:
      - POSTGRES_USER=op
      - POSTGRES_PASSWORD=op
      - POSTGRES_DB=parliament
      - PGUSER=op
      - PGDATABASE=parliament

  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:9.5.3
    volumes:
      - esdata:/usr/share/elasticsearch/data
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
    ports:
      - "9200:9200"

  # pgadmin:
  #   image: dpage/pgadmin4
  #   ports:
  #     - "5679:80"
  #   environment:
  #     - PGADMIN_DEFAULT_EMAIL=admin@admin.com
  #     - PGADMIN_DEFAULT_PASSWORD=admin

volumes:
  pgdata:
  opmedia:
  esdata: