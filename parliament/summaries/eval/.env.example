# promptfoo loads .env (gitignored) automatically when run from this directory.
# `npm install` copies this file to .env if there isn't one yet.

# Same key as settings.OPENROUTER_API_KEY
OPENROUTER_API_KEY=
PROMPTFOO_DISABLE_TELEMETRY=1
# The Python that runs the hooks in promptfoo_eval.py; it needs Jinja2. `npm install` creates it.
PROMPTFOO_PYTHON=.venv/bin/python
